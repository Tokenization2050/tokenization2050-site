{% extends "base.njk" %}

{% block title %}Glossary — Tokenization 2050{% endblock %}
{% block description %}Definitions of key terms in tokenization, real-world assets, stablecoins, and digital finance.{% endblock %}
{% block ogTitle %}Glossary — Tokenization 2050{% endblock %}
{% block ogUrl %}{{ config.site.url }}/glossary/{% endblock %}
{% block canonical %}{{ config.site.url }}/glossary/{% endblock %}

{% block content %}
<div class="container">
  <div class="glossary-page">
    <h1>Glossary</h1>
    <p>Definitions of key terms in tokenization, real-world assets, and digital finance.</p>

    <dl class="glossary-list">
      {% for item in glossary %}
      <div class="glossary-item" id="{{ item.term | lower | replace(' ', '-') | replace('(', '') | replace(')', '') }}">
        <dt>{{ item.term }}</dt>
        <dd>{{ item.definition }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</div>
{% endblock %}
