{% from "_macros.njk" import socialLinks, whatsappButton %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ pageTitle }} — Tokenization 2050{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ config.site.description }}{% endblock %}">

  {# Open Graph #}
  <meta property="og:title" content="{% block ogTitle %}{{ pageTitle }} — Tokenization 2050{% endblock %}">
  <meta property="og:description" content="{% block ogDescription %}{{ config.site.description }}{% endblock %}">
  <meta property="og:type" content="{% block ogType %}website{% endblock %}">
  <meta property="og:url" content="{% block ogUrl %}{{ config.site.url }}{% endblock %}">
  <meta property="og:site_name" content="Tokenization 2050">
  <meta property="og:locale" content="en_US">
  <meta property="og:image" content="{{ config.site.url }}{{ config.brand.shareImage }}">
  <meta property="og:image:width" content="{{ config.brand.shareImageWidth }}">
  <meta property="og:image:height" content="{{ config.brand.shareImageHeight }}">
  <meta property="og:image:alt" content="Tokenization 2050">

  {# Twitter Card #}
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% block twitterTitle %}{{ pageTitle }} — Tokenization 2050{% endblock %}">
  <meta name="twitter:description" content="{% block twitterDescription %}{{ config.site.description }}{% endblock %}">
  <meta name="twitter:image" content="{{ config.site.url }}{{ config.brand.shareImage }}">

  {# Icons (official white avatar, see LOGHI/) #}
  <link rel="icon" href="{{ config.brand.icon }}" type="image/svg+xml">
  <link rel="icon" href="{{ config.brand.favicon32 }}" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="{{ config.brand.appleTouchIcon }}">
  <link rel="manifest" href="/assets/site.webmanifest">
  <meta name="theme-color" content="{{ config.brand.themeColor }}">

  {# Canonical #}
  <link rel="canonical" href="{% block canonical %}{{ config.site.url }}{% endblock %}">

  {# Feeds #}
  <link rel="alternate" type="application/rss+xml" title="Tokenization 2050 RSS Feed" href="{{ config.site.url }}/feed.xml">
  <link rel="alternate" type="application/json" title="Tokenization 2050 JSON Feed" href="{{ config.site.url }}/feed.json">

  {# Fonts #}
  <link rel="preload" href="/assets/fonts/inter-latin-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/inter-latin-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/dm-serif-display-latin-400.woff2" as="font" type="font/woff2" crossorigin>

  {# Stylesheet #}
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/style.css">

  {# schema.org Organization on every page; "sameAs" = every channel in config.social #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NewsMediaOrganization",
    "@id": "{{ config.site.url }}/#organization",
    "name": "Tokenization 2050",
    "url": "{{ config.site.url }}",
    "logo": { "@type": "ImageObject", "url": "{{ config.site.url }}{{ config.brand.icon512 }}", "width": 512, "height": 512 },
    {% if contactEmail %}"email": "{{ contactEmail }}",{% endif %}
    "sameAs": [{% for c in social %}"{{ c.url }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  }
  </script>

  {% block head %}{% endblock %}
  <script src="/assets/js/site.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  {% if previewMode %}
  <div class="preview-banner" role="note">PREVIEW ONLY · demo numbers and draft articles on this computer · never published</div>
  {% endif %}

  {# ---- TICKER STRIP ---- #}
  {# Only items with a verified value (filtered in build.js); hidden entirely when none #}
  {% if tickerItems and tickerItems.length > 0 %}
  {# Scrolls continuously (CSS). The second copy makes the loop seamless and is
     hidden from screen readers. Pauses on hover/focus and with the button;
     static and swipeable with prefers-reduced-motion. #}
  <div class="ticker" role="region" aria-label="Key market figures" style="--ticker-duration: {{ tickerItems.length * 7 }}s">
    <div class="ticker-viewport">
      <div class="ticker-track">
        {% for copy in [1, 2] %}
        <div class="ticker-group"{% if copy === 2 %} aria-hidden="true"{% endif %}>
          {% for item in tickerItems %}
          <div class="ticker-item">
            <span class="ticker-label">{{ item.label }}</span>
            <span class="ticker-value tabular-nums">{{ item.value }}</span>
            {% if item.change %}<span class="ticker-change {{ item.direction }} tabular-nums">{% if item.direction === 'up' %}▲{% elif item.direction === 'down' %}▼{% endif %} {{ item.change }}</span>{% endif %}
          </div>
          <span class="ticker-sep" aria-hidden="true">|</span>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
    </div>
    <button type="button" class="ticker-pause" aria-pressed="false" hidden><span class="sr-only">Pause scrolling figures</span><span aria-hidden="true">❚❚</span></button>
  </div>
  {% endif %}

  {# ---- HEADER ---- #}
  <header class="site-header">
    <div class="container">
      <div class="header-top">
        <a href="/" class="site-logo" aria-label="Tokenization 2050 — Home">
          <img src="{{ config.brand.logo }}" alt="Tokenization 2050" width="{{ config.brand.logoWidth }}" height="{{ config.brand.logoHeight }}">
        </a>
        <button class="nav-toggle" aria-label="Open navigation menu" aria-expanded="false" onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true'); document.querySelector('.site-nav').classList.toggle('open');">
          ☰ Menu
        </button>
        <div class="header-right">
          <span class="header-date">{{ buildDate }}</span>
          {{ socialLinks(social, 16, "social-links--header") }}
          {% if whatsapp %}{{ whatsappButton(whatsapp, "Follow on WhatsApp", "btn-whatsapp--header") }}{% endif %}
        </div>
      </div>

      <nav class="site-nav" aria-label="Main navigation">
        {# Main row = config.nav.primary; "More" dropdown = config.nav.secondary.
           On phones the "More" items are shown inline in the open menu. #}
        <ul class="nav-list">
          {% for slug in config.nav.primary %}
          {% set section = sectionMap[slug] %}
          {% if section %}
          <li><a href="/{{ section.slug }}/"{% if currentSection === section.slug %} aria-current="page"{% endif %}>{{ section.name }}</a></li>
          {% endif %}
          {% endfor %}
          {% if config.nav.secondary.length %}
          <li class="nav-more{% if currentSection in config.nav.secondary %} is-current{% endif %}">
            <button type="button" class="nav-more-toggle" aria-expanded="false" aria-controls="nav-more-list">More <span aria-hidden="true">▾</span></button>
            <ul id="nav-more-list" class="nav-more-list">
              {% for slug in config.nav.secondary %}
              {% set section = sectionMap[slug] %}
              {% if section %}
              <li><a href="/{{ section.slug }}/"{% if currentSection === section.slug %} aria-current="page"{% endif %}>{{ section.name }}</a></li>
              {% endif %}
              {% endfor %}
            </ul>
          </li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </header>

  {# ---- LATEST HEADLINES STRIP ---- #}
  {# Rotates through the newest headlines every 6 s (site.js). Without JS, or
     with prefers-reduced-motion, it shows the newest one and the arrows. #}
  {% if latestHeadlines and latestHeadlines.length > 0 %}
  <div class="latest-strip" role="region" aria-label="Latest headlines">
    <div class="container latest-strip-inner">
      <span class="latest-strip-label">Latest</span>
      <ul class="latest-strip-list">
        {% for h in latestHeadlines %}
        <li class="latest-strip-item{% if loop.first %} is-active{% endif %}"{% if not loop.first %} hidden{% endif %}>
          <a href="{{ h.url }}">{{ h.title }}</a>
          <time class="latest-strip-time" datetime="{{ h.publishedAt }}">{{ h.timeAgo }}</time>
        </li>
        {% endfor %}
      </ul>
      {% if latestHeadlines.length > 1 %}
      <div class="latest-strip-controls" hidden>
        <button type="button" data-dir="-1"><span class="sr-only">Previous headline</span><span aria-hidden="true">‹</span></button>
        <button type="button" class="latest-strip-pause" aria-pressed="false"><span class="sr-only">Pause headlines</span><span aria-hidden="true">❚❚</span></button>
        <button type="button" data-dir="1"><span class="sr-only">Next headline</span><span aria-hidden="true">›</span></button>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {# ---- MAIN CONTENT ---- #}
  <main id="main-content">
    {% block content %}{% endblock %}
  </main>

  {# ---- FOOTER ---- #}
  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-brand">
          <a href="/" class="site-logo" aria-label="Tokenization 2050 — Home">
            <img src="{{ config.brand.logo }}" alt="Tokenization 2050" width="{{ config.brand.logoWidth }}" height="{{ config.brand.logoHeight }}" loading="lazy">
          </a>
          <p>Global information provider on tokenization and real-world assets.</p>
          {% if social.length %}
          <p class="footer-follow">Follow Tokenization 2050</p>
          {{ socialLinks(social, 20, "social-links--footer") }}
          {% endif %}
          {% if contactEmail %}<p class="footer-email"><a href="mailto:{{ contactEmail }}">{{ contactEmail }}</a></p>{% endif %}
        </div>

        <div class="footer-nav">
          <div class="footer-nav-group">
            <h2>Sections</h2>
            <ul>
              {% for section in config.sections %}
              {% if section.slug !== 'data' and section.slug !== 'glossary' %}
              <li><a href="/{{ section.slug }}/">{{ section.name }}</a></li>
              {% endif %}
              {% endfor %}
            </ul>
          </div>
          <div class="footer-nav-group">
            <h2>Company</h2>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/editorial-standards/">Editorial Standards</a></li>
              <li><a href="/corrections/">Corrections</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy Policy</a></li>
              <li><a href="/legal/">Legal Notice</a></li>
              <li><a href="/data/">Data</a></li>
              <li><a href="/glossary/">Glossary</a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="footer-disclaimer">{{ config.site.disclaimer }}</p>
        <p class="footer-copyright">{{ config.site.copyright }}</p>
      </div>
    </div>
  </footer>

  {# Sticky WhatsApp button, phones only (CSS) #}
  {% if whatsapp %}
  <div class="whatsapp-sticky">{{ whatsappButton(whatsapp, "Follow on WhatsApp", "btn-whatsapp--sticky") }}</div>
  {% endif %}

</body>
</html>
